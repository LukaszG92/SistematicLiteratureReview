@article{ruskanda_simple_2023,
	title = {Simple {Sentiment} {Analysis} {Ansatz} for {Sentiment} {Classification} in {Quantum} {Natural} {Language} {Processing}},
	volume = {11},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2023.3327873},
	abstract = {Sentiment classification is a valuable application of natural language processing that has seen wide usage in optimizing business processes. This paper explores a novel implementation of sentiment analysis using the Variational Quantum Algorithms (VQA) framework. As ansatz choice determines model performance in VQA, this paper proposes an alternative ansatz for the sentiment classification task in quantum representation. Specifically, it builds upon previous work in quantum sentiment classification by proposing an alternative ansatz to the Instantaneous Quantum Polytime ansatz, entitled Simple Sentiment Analysis (SimpleSA) ansatz. A key feature of the SimpleSA ansatz is the decision to neglect noun parameterization. The proposed SimpleSA has less complexity than the other ansätze in terms of the number of parameters and the number of gates. Moreover, experimental results show that the SimpleSA ansatz with H-CNOT-Rz-H compound block construction outperforms the Instantaneous Quantum Polytime (IQP) ansatz at 85.00\% accuracy. Furthermore, SimpleSA optimization converges 20.89\% faster than Instantaneous Quantum Polytime (IQP) for the Simultaneous Perturbation Stochastic Approximation (SPSA) method with 130 iterations. The proposed work is useful for applications of quantum computers for sentiment analyses and classifications.},
	journal = {IEEE Access},
	author = {Ruskanda, Fariska Zakhralativa and Abiwardani, Muhammad Rifat and Syafalni, Infall and Larasati, Harashta Tatimma and Mulyawan, Rahmat},
	year = {2023},
	keywords = {Computational modeling, Integrated circuit modeling, Machine learning, Natural language processing, Quantum computing, quantum machine learning, Quantum circuit, Classification algorithms, Sentiment analysis, sentiment classification, Quantum natural language processing, ansatz, quantum circuit},
	pages = {120612--120627},
	annote = {Cited by: 15; All Open Access; Gold Open Access; Green Open Access},
}

@inproceedings{sreedhar_towards_2025,
	title = {Towards {Scalable} and {Accurate} {QNLP} {Models}: {A} {ZX}-{Calculus} and {Hilbert} {Space} {Approach}},
	doi = {10.1109/ICSCDS65426.2025.11167678},
	abstract = {Quantum Natural language processing (QNLP) is the new technology that incorporates the theory of quantum computing with the linguistic theory to make more effective and transparent models of comprehending natural language. The paper proposes QNLP model of type combining the vector space semantics and the graphical ZX-calculus, applicable to quantum computing to describe, process, and interpret the sentences structure as a quantum circuit. Its approach includes a sentence parsing with a categorial grammar, a mapping of the semantic constituents to products of high dimensional Hilbert spaces and a representation of their interaction with the so-called ZX-diagrams. Such circuits are compiled into quantum instructions and emulated on quantum devices such as Qiskit. The model was compared in terms of the accuracy of parse, preservation of semantics, diagrammatic effectiveness, quantum fidelity and sentence reprehensibility. This has been demonstrated to match the outputs of classical and quantum semantics, by 86 percent on parsing accuracy and above 96\% on quantum circuit fidelity. The paper shows ZX-calculus is a potentially powerful and understandable framework to construct large-scale and semantically rich QNLP systems, given near-term quantum hardware.},
	booktitle = {2025 3rd {International} {Conference} on {Sustainable} {Computing} and {Data} {Communication} {Systems} ({ICSCDS})},
	author = {Sreedhar, B and Pathapati, Saroja and Krishna, S Vineela and Ramachandrapuram, Pavitra and Kumar M, V T Ram Pavan and Kumar, Gangu Vijay},
	month = aug,
	year = {2025},
	keywords = {Computational modeling, Integrated circuit modeling, Natural language processing, Semantics, Vectors, Accuracy, Linguistics, Quantum circuit, Quantum Natural Language Processing, Quantum mechanics, Hilbert space, Quantum Circuit Simulation, Vector Space Semantics, ZX-Calculus},
	pages = {945--950},
	annote = {Cited by: 0},
}

@inproceedings{ruskanda_enhancing_2024,
	title = {Enhancing {Quantum} {NLP} {Robustness} - {Analysis} on {Noisy} {Models} for {Quantum} {Sentiment} {Classification}},
	issn = {2996-2552},
	doi = {10.1109/ICAICTA63815.2024.10763118},
	abstract = {This research aims to improve the robustness of Quantum Natural Language Processing (QNLP) models in the presence of noise. Using Lambeq, an open-source library for quantum NLP, we focus on sentiment classification tasks to eval-uate the impact of noisy quantum models. Our study involves the application of three types of optimizers: Simultaneous Perturbation Stochastic Approximation (SPSA), Nelder-Mead, and Adam. The performance and resilience of these optimizers are assessed under various noise conditions to determine their effectiveness in maintaining model accuracy and stability. The research shows that the Adam optimizer outperforms SPSA and NelderMead in QNLP simple sentiment analysis tasks, both in noiseless and noisy environments. Adam achieved 96.67 \% accuracy in noiseless conditions, significantly higher than SPSA's 83.33 \% and Nelder-Mead's 53.33\%, highlighting its superior performance in optimizing quantum circuits. Moreover, in noisy simulation, Adam outperforms others with 70.00\% accuracy performance. The work is useful for NLP implementations in quantum computers. This research is essential because the noisy nature of current quan-tum computers makes it difficult for QNLP models to perform accurately and reliably.},
	booktitle = {2024 11th {International} {Conference} on {Advanced} {Informatics}: {Concept}, {Theory} and {Application} ({ICAICTA})},
	author = {Ruskanda, Fariska Zakhralativa and Halim, Michael Jonathan and Kurniawan, Farizki and Syafalni, Infall and Mulyawan, Rahmat and Higo, Akio},
	month = sep,
	year = {2024},
	keywords = {Computational modeling, Computers, Accuracy, Quantum Natural Language Processing, Quantum mechanics, Noise, Noise measurement, Sentiment analysis, sentiment classification, Robustness, Stochastic processes, Stability analysis, noisy quantum, robustness},
	pages = {1--6},
	annote = {Cited by: 1},
}

@inproceedings{ruskanda_evaluating_2025,
	title = {Evaluating {Encoding} {Strategies} and {Quantum} {Circuit} {Designs} for {Sentiment} {Classification}},
	issn = {2474-9745},
	doi = {10.1109/ISPACS68724.2025.11382677},
	abstract = {We present a component-wise ablation study of a quantum natural language processing (QNLP) pipeline for sentiment classification, focusing on how classical and quantum design choices interact under NISQ constraints. Starting from a baseline, we evaluate five different qubit numbers, six sentence embedding strategies, two dimensionality reduction methods, two feature encoding schemes, and three variational ansatzes. Each stage is tested independently while fixing previously optimized components, allowing us to isolate the contribution of each. Experiments are conducted on simulated quantum backends. We find that sentence-level transformer embeddings (MiniLM, MPNet), linear dimensionality reduction (PCA), and simple angle encoding provide substantial accuracy gains without additional training cost. Finally, we introduce a shallow custom ansatz that induces a multiplicative cosine kernel across qubits. While the best overall test accuracy (87 \%) is achieved using the RealAmplitude ansatz, the custom ansatz closely follows (86.5 \%) while reducing runtime by over 35 \%(277 {\textbackslash}mathrms vs. 432 s). This demonstrates a promising trade-off between performance and efficiency, supporting the design of scalable QNLP pipelines under limited quantum resources.},
	booktitle = {2025 {International} {Symposium} on {Intelligent} {Signal} {Processing} and {Communication} {Systems} ({ISPACS})},
	author = {Ruskanda, Fariska Zakhralativa and Kurniawan, Farizki and Syafalni, Infall},
	month = nov,
	year = {2025},
	keywords = {Qubit, Signal processing, Encoding, Accuracy, Quantum circuit, Training, Dimensionality reduction, Sentiment analysis, Transformers, Pipelines, sentiment analysis, Quantum natural language processing, ansatz design, variational quantum circuits},
	pages = {1--6},
	annote = {Cited by: 0},
}

@article{abiwardani_generalized_2025,
	title = {Generalized {Ansatz} for {High}-{Accuracy} {Quantum} {Sentiment} {Classification} {Using} {Variational} {Quantum} {Algorithm} {Scheme}},
	volume = {13},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2025.3596031},
	abstract = {This paper investigates sentiment classification using QNLP within the Variational Quantum Algorithms (VQA) framework, which offers a practical approach for current hardware limitations by optimizing parameterized quantum circuits through classical computation. While the quantum computer is not ready yet for commercialization, the development and testing of quantum algorithms in classical simulations are useful for finding the quantum advantages. Moreover, designing an effective VQA ansatz is a key challenge because it directly influences the model’s expressiveness and trainability. To address this, a new ansatz called the GeneralQC ansatz is proposed by combining the preliminary SimpleSA ansatz with the circuit-centric quantum classifier, aiming to enhance performance by integrating the strengths of both methods. Three instantiations of the GeneralQC ansatz—H-CRx, Rx-CNOT, and Rx-CRz—are explored under the SimpleSA strategy of defining noun word boxes as fixed identity gates and are compared with both the baseline SimpleSA ansatz and versions with noun parameterization. The findings reveal that the Rx-CNOT and Rx-CRz models with non-parameterized nouns significantly outperform the SimpleSA ansatz, achieving an accuracy of 96.92\%.},
	journal = {IEEE Access},
	author = {Abiwardani, Muhammad Rifat and Ruskanda, Fariska Zakhralativa and Syafalni, Infall and Mulyawan, Rahmat and Higo, Akio},
	year = {2025},
	keywords = {Computational modeling, Machine learning, Natural language processing, Quantum computing, Qubit, Quantum circuit, Logic gates, Sentiment analysis, Transformers, sentiment classification, Pipelines, Quantum natural language processing, ansatz},
	pages = {157551--157569},
	annote = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
}

