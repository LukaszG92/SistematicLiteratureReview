@inproceedings{muralikrishna_experimentation_2024,
	title = {Experimentation on {Various} {Sentiment} {Classification} {Models} in {Quantum} {Natural} {Language} {Processing}},
	doi = {10.1109/ARIIA63345.2024.11051727},
	abstract = {Quantum computers has the capacity to enhance the speed of intricate calculations, achieve parallelism via superpositions, and effectively process vast amounts of data. In addition, the domain of natural language processing (NLP) is swiftly drawing the attention of academics and engineers that want to construct more extensive computational models for NLP. Hence, the use of quantum technology in NLP endeavours, particularly in sentiment categorization, has promising prospects for further advancement. In this research work, a detailed analysis of different sentiment classification methods are investigated that are interpreted with quantum computing models. To be precise the Quantum Long Short Term Memory (QLSTM) and Quantum Support Vector Machines (QSVM) are examined to determine the efficiency among the models. The results are simulated in Qiskit simulator and real time quantum computer Qiskit\_ibm\_osaka to evaluate the examined models. The results shows the significance of the experimentation and it is proven using Accuracy, precision and recall as performance metrices. On an average, in terms of accuracy the proposed model outperforms existing methods with 8.9\%, On precision the proposed model outperforms 11.1\% compared to existing methods. And with respect to recall the proposed model outperforms 6.7\% compared to existing methods.},
	booktitle = {2024 {International} {Conference} on {Augmented} {Reality}, {Intelligent} {Systems}, and {Industrial} {Automation} ({ARIIA})},
	author = {Muralikrishna, Muddada and Nandini, Sekhermahanti S and Keerthi Sagiraju, Hima and Vankara, Jayavani and Ratnam, K Venkata},
